{
	"name": "streamy",
	"version": "0.0.1",
	"description": "",
	"author": "",
	"private": true,
	"license": "GPL-3.0-only",
	"scripts": {
		"minio:down:dev": "sudo docker compose rm minio -f -s",
		"minio:up:dev": "sudo docker compose up minio -d",
		"db:gen:migrate": "npx drizzle-kit generate:pg",
		"db:run:migrate": "tsx ./src/drizzle/migrate.ts",
		"db:up:dev": "sudo docker compose up streamy_db -d",
		"db:down:dev": "sudo docker compose down streamy_db",
		"db:rm:dev": "sudo docker compose rm streamy_db -f -s",
		"db:rebuild:dev": "npm run db:rm:dev && npm run db:up:dev && sleep 5 && npm run db:run:migrate",
		"db:up:test": "sudo docker compose up streamy_db_test -d",
		"db:down:test": "sudo docker compose down streamy_db_test",
		"db:rm:test": "sudo docker compose rm streamy_db_test -f -s",
		"db:rebuild:test": "npm run db:rm:test && npm run db:up:test && sleep 5 && npm run db:run:migrate",
		"build": "nest build",
		"format": "prettier --check \"src/**/*.ts\" \"scripts/**/*.ts\"",
		"start": "nest start",
		"start:dev": "nest start --watch",
		"start:debug": "nest start --debug --watch",
		"start:prod": "node dist/src/main",
		"lint": "eslint \"{src,apps,libs,scripts}/**/*.ts\" --fix",
		"test": "vitest run",
		"test:e2e:vod": "tsx scripts/e2e-vod.ts",
		"test:e2e:live": "tsx scripts/e2e-live.ts",
		"requeue:dead-letter": "tsx scripts/requeue-dead-letter.ts",
		"test:watch": "vitest",
		"test:cov": "vitest run --coverage",
		"test:db": "vitest run --config vitest.db.config.ts",
		"verify": "npm run lint && npm run build && npm test"
	},
	"dependencies": {
		"@elastic/elasticsearch": "^8.19.2",
		"@miadabdi/streamy-queues": "*",
		"@nestjs-modules/mailer": "^2.3.7",
		"@nestjs/common": "^11.2.3",
		"@nestjs/config": "^4.0.4",
		"@nestjs/core": "^11.2.3",
		"@nestjs/elasticsearch": "^11.1.0",
		"@nestjs/jwt": "^11.0.0",
		"@nestjs/passport": "^11.0.5",
		"@nestjs/platform-express": "^11.2.3",
		"@nestjs/swagger": "^11.4.7",
		"@nestjs/throttler": "^6.4.0",
		"amqp-connection-manager": "^4.1.14",
		"amqplib": "^0.10.9",
		"argon2": "^0.44.0",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.14.2",
		"compression": "^1.8.1",
		"cookie-parser": "^1.4.7",
		"dotenv": "^17.2.2",
		"dotenv-expand": "^12.0.3",
		"drizzle-orm": "^0.44.5",
		"drizzle-zod": "^0.8.3",
		"helmet": "^8.1.0",
		"hpp": "^0.2.3",
		"joi": "^18.0.1",
		"minio": "^8.0.6",
		"moment": "^2.30.1",
		"multer": "^2.0.2",
		"nest-winston": "^1.10.2",
		"nestjs-cls": "^6.0.1",
		"nestjs-minio-client": "^2.2.0",
		"nodemailer": "^10.0.1",
		"passport": "^0.7.0",
		"passport-jwt": "^4.0.1",
		"passport-local": "^1.0.0",
		"pg": "^8.16.3",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2",
		"sharp": "^0.34.4",
		"tsx": "^4.20.5",
		"uuid": "^14.0.2",
		"winston": "^3.17.0",
		"winston-daily-rotate-file": "^5.0.0"
	},
	"devDependencies": {
		"@nestjs/cli": "^11.0.24",
		"@nestjs/schematics": "^11.1.0",
		"@nestjs/testing": "^11.2.3",
		"@types/amqplib": "^0.10.7",
		"@types/compression": "^1.8.1",
		"@types/cookie-parser": "^1.4.9",
		"@types/express": "^5.0.3",
		"@types/hpp": "^0.2.6",
		"@types/multer": "^2.0.0",
		"@types/node": "^26.5.0",
		"@types/nodemailer": "^7.0.1",
		"@types/passport-jwt": "^4.0.1",
		"@types/passport-local": "^1.0.38",
		"@types/pg": "^8.15.5",
		"@typescript-eslint/eslint-plugin": "^8.44.1",
		"@typescript-eslint/parser": "^8.44.1",
		"@vitest/coverage-v8": "^5.0.0",
		"drizzle-kit": "^0.31.4",
		"eslint": "^9.36.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.4",
		"npm-run-all": "^4.1.5",
		"prettier": "^3.6.2",
		"source-map-support": "^0.5.21",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0",
		"typescript": "~5.9.3",
		"vite": "^8.2.2",
		"vitest": "^5.0.0"
	},
	"engines": {
		"node": ">20.15.0"
	}
}
