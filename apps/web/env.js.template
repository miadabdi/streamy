// Rendered to /usr/share/nginx/html/env.js by the container entrypoint
// (envsubst) — read by src/lib/env.ts via window.__ENV__. Empty values are
// treated as unset there; don't add interpolation outside the quoted vars.
window.__ENV__ = {
	WORKER_API: '${WEB_WORKER_API}',
	RTMP_HOST: '${WEB_RTMP_HOST}',
};
