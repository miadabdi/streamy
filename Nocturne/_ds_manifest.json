{"namespace":"Nocturne_noctur","components":[],"startingPoints":[],"cards":[{"path":"components/buttons.html","group":"Components","viewport":"640x460","subtitle":"Outlined primary actions; tags tint from the ramps","name":"Buttons & tags"},{"path":"components/cards.html","group":"Components","viewport":"640x420","subtitle":"Surface-filled cards with a kicker, title, body and meta row","name":"Cards"},{"path":"components/dialog.html","group":"Components","viewport":"640x460","subtitle":"A modal surface at the top elevation, shown here inside a static frame","name":"Dialog"},{"path":"components/forms.html","group":"Components","viewport":"640x520","subtitle":"Text inputs, a segmented control and radios — native elements, themed states","name":"Forms"},{"path":"components/navigation.html","group":"Components","viewport":"640x420","subtitle":"A header bar over a left page opening","name":"Navigation"},{"path":"components/ops.html","group":"Components","viewport":"700x900","subtitle":"Health tiles, masked stream key, ffmpeg log drawer, wizard steps, dropzone, empty state, toasts","name":"Ops & studio parts"},{"path":"components/table.html","group":"Components","viewport":"640x420","subtitle":"Rows separated by a whisper of the text color; status cells reuse the tags","name":"Table"},{"path":"components/video.html","group":"Components","viewport":"700x680","subtitle":"Grid, list and live cards; the thumbnail fallback; the seven status pills","name":"Video card & status"},{"path":"foundations/brand.html","group":"Foundations","viewport":"640x620","subtitle":"The STREAMY wordmark and the geometric icon set for video, live and ops","name":"Brand & icons"},{"path":"foundations/color.html","group":"Foundations","viewport":"640x560","subtitle":"Role colors and the tonal ramps (mono scheme — one accent voice)","name":"Color"},{"path":"foundations/icons.html","group":"Foundations","viewport":"640x420","subtitle":"Phosphor — inline SVG on currentColor","name":"Icons"},{"path":"fo